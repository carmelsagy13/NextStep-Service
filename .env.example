# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nextstep

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=1d

# Open Finance API
OPEN_FINANCE_BASE_URL=https://api.open-finance.co.il
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_REDIRECT_URI=http://localhost:3000/openfinance/callback

# Open Finance API (connect-api flow)
OF_BASE_URL=https://api.open-finance.ai
OF_CLIENT_ID=
OF_CLIENT_SECRET=
OF_USERNAME=
OF_PASSWORD=
OF_INCLUDE_FAKE_PROVIDERS=true

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
