# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nextstep

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=1d

# Open Finance API
OPEN_FINANCE_BASE_URL=https://api.open-finance.co.il
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_REDIRECT_URI=http://localhost:3000/openfinance/callback

# Open Finance API (connect-api flow)
OF_BASE_URL=https://api.open-finance.ai
OF_CLIENT_ID=
OF_CLIENT_SECRET=
OF_USERNAME=
OF_PASSWORD=
OF_INCLUDE_FAKE_PROVIDERS=true

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── LLM provider selection ──────────────────────────────────────────────
# Primary provider: 'college' (the College LLM service) or 'gemini'.
LLM_PROVIDER=college
# When the primary provider fails, automatically fall back to the other one.
LLM_FALLBACK=true

# ─── College LLM service (Ollama + OpenAI-compatible) ────────────────────
# Requires VPN access to the internal network.
COLLEGE_LLM_BASE_URL=http://10.10.248.41
COLLEGE_LLM_USERNAME=student1
COLLEGE_LLM_PASSWORD=pass123
# Which model to use. Ollama models: llama3.1:8b | mistral:latest | gemma2:9b |
# gemma3:12b | qwen2.5-coder:32b. OpenAI-compatible model: gpt-oss-120b.
COLLEGE_LLM_MODEL=llama3.1:8b
# API style: 'ollama' (default) or 'openai'. Leave blank to auto-detect
# (gpt-oss-* -> openai, everything else -> ollama).
COLLEGE_LLM_API=
# Max tokens to generate and request timeout (ms).
COLLEGE_LLM_NUM_PREDICT=3000
COLLEGE_LLM_TIMEOUT_MS=120000
